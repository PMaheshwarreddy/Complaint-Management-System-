# =================================================================
# Server Configuration
# =================================================================
PORT=5000
NODE_ENV=development
BACKEND_DOMAIN=http://localhost:5000
FRONTEND_DOMAIN=http://localhost:5173

# =================================================================
# Database & Session Configuration
# =================================================================
MONGO_URL=mongodb://localhost:27017
DB_NAME=ComplaintManagement
SESSION_SECRET_KEY=your_super_secret_session_key_here

# =================================================================
# Google OAuth 2.0 Authentication
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/grievance/auth/google/callback
# =================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Restrict registrations to a specific domain (e.g. myorg.com)
# Leave empty to allow any valid Google email account
ALLOWED_EMAIL_DOMAIN=

# =================================================================
# Cloudinary (Media File Storage for Images & Videos)
# Obtain credentials from: https://cloudinary.com/console
# =================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

